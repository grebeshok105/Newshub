# ──────────────────────────────────────────────
# NewsHub Telegram Bot — Environment Configuration
# ──────────────────────────────────────────────
# Copy this file to .env and fill in real values.

# Telegram Bot (from @BotFather)
BOT_TOKEN=your_bot_token_here

# Telethon userbot (from https://my.telegram.org)
TELETHON_API_ID=your_api_id
TELETHON_API_HASH=your_api_hash
TELETHON_SESSION_NAME=newshub_session
TELETHON_PHONE=+7XXXXXXXXXX

# Google Gemini (from https://aistudio.google.com/apikey)
GEMINI_API_KEY=your_gemini_key
GEMINI_MODEL=gemini-2.0-flash

# Channels to track (comma-separated usernames without @)
CHANNELS=raiznews,retakenews,newcsgo,cscis

# Channel priorities (JSON: username -> priority 1=🔥high, 2=normal, 3=low)
CHANNEL_PRIORITIES={"raiznews": 1, "retakenews": 1, "newcsgo": 2, "cscis": 2}

# Blacklist words (comma-separated, case-insensitive)
BLACKLIST_WORDS=скины,розыгрыш,giveaway,реклама,vacnet

# Schedule
DIGEST_HOUR=9
TIMEZONE=Europe/Moscow
CHANNEL_FETCH_INTERVAL=15

# Pagination
PAGE_SIZE=5

# Database
DATABASE_PATH=newshub.db

# Logging
LOG_LEVEL=INFO
